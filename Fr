--[[
    DM HUNTER - Dark Matter ore detector + server hopper (Pet Simulator 99)
    Requires an executor with: game:HttpGet (and ideally gethui/writefile/queue_on_teleport)

    GUI:
      - Enable DM Hunter   : master switch (scanning + status)
      - Auto server hop    : hop when no Dark Matter ore is left in the server
      - Ore ESP            : highlight + name/distance tag on every match
      - Hop delay          : seconds to wait (after nothing is left) before hopping
      - HOP NOW            : hop immediately
]]

-- ========================= CONFIG =========================
local Config = {
    Keywords     = { "dark matter" }, -- lowercase; change if the in-game name differs
    ScanGrace    = 6,                 -- seconds after joining before "nothing found" counts
    AutoTeleport = false,             -- true = teleport next to each ore once when found
    MinPlayers   = 1,
    MaxFillRatio = 0.85,
    -- Raw URL of THIS script so it re-runs after each hop. "" = disabled.
    ScriptURL    = "",
}
-- ==========================================================

if not game:IsLoaded() then game.Loaded:Wait() end

local Players         = game:GetService("Players")
local Workspace       = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService     = game:GetService("HttpService")
local UserInputService= game:GetService("UserInputService")
local TweenService    = game:GetService("TweenService")
local RunService      = game:GetService("RunService")
local CoreGui         = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlaceId, JobId = game.PlaceId, game.JobId

-- ---------------------- persistence -------------------------
local SAVE_FILE = "dm_hunter.json"
local Save = { hops = 0, visited = {}, enabled = true, autoHop = true, esp = true, hopDelay = 4 }

pcall(function()
    if isfile and isfile(SAVE_FILE) then
        local data = HttpService:JSONDecode(readfile(SAVE_FILE))
        for k, v in pairs(data) do Save[k] = v end
    end
end)
Save.visited[JobId] = true

local function persist()
    pcall(function()
        if writefile then writefile(SAVE_FILE, HttpService:JSONEncode(Save)) end
    end)
end

local queueTeleport = queue_on_teleport or (syn and syn.queue_on_teleport)
if queueTeleport and Config.ScriptURL ~= "" then
    queueTeleport(("loadstring(game:HttpGet(%q))()"):format(Config.ScriptURL))
end

