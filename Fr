-- Server Hop Engine with Randomized Delay
local function HopServer()
    if State.IsHopping then return end
    State.IsHopping = true
    StatusLabel.Text = "Server Hopping..."
    StatusLabel.TextColor3 = Color3.fromRGB(180, 120, 255)

    c_spawn(function()
        -- Small randomized delay before HTTP call to break rigid pattern
        c_wait(math.random(2, 8) / 10)

        local success, result = c_pcall(function()
            local url = string.format("https://games.roblox.com/v1/games/%s/servers/0?sortOrder=Asc&limit=100", tostring(PlaceId))
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            local validServers = {}
            for _, server in ipairs(result.data) do
                if type(server) == "table" and server.id ~= JobId and server.playing then
                    if server.playing >= Config.MinPlayers and server.playing <= Config.MaxPlayers then
                        table.insert(validServers, server.id)
                    end
                end
            end

            if #validServers > 0 then
                State.TotalHops = State.TotalHops + 1
                TeleportService:TeleportToPlaceInstance(PlaceId, validServers[math.random(1, #validServers)], LocalPlayer)
                return
            end
        end

        TeleportService:Teleport(PlaceId, LocalPlayer)
    end)
end

HopButton.MouseButton1Click:Connect(HopServer)

-- Scanner Engine
local function ScanTargetOres()
    local count = 0
    local things = Workspace:FindFirstChild("__THINGS")
    local blockWorlds = things and things:FindFirstChild("BlockWorlds")

    if blockWorlds then
        State.InMiningZone = true
        for _, container in ipairs(blockWorlds:GetChildren()) do
            if string.find(container.Name, "Blocks") then
                for _, block in ipairs(container:GetChildren()) do
                    local rawId = block:GetAttribute("id") or block:GetAttribute("Id") or block:GetAttribute("ID") or block:GetAttribute("Type") or block.Name
                    if rawId then
                        local idLower = string.lower(tostring(rawId))
                        if Config.TargetIDs[idLower] or string.find(idLower, "rainbow") or string.find(idLower, "dark") then
                            count = count + 1
                        end
                    end
                end
            end
        end
    else
        State.InMiningZone = false
    end

    return count
end

-- Main Loop
c_spawn(function()
    while State.BootTimer > 0 do
        StatusLabel.Text = string.format("booting %ds...", math.ceil(State.BootTimer))
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        InfoBox.Text = string.format(
            "zone: booting  dm: 0\nhops: %d\nstatus: waiting boot",
            State.TotalHops
        )
        c_wait(1)
        State.BootTimer = State.BootTimer - 1
    end

    State.IsBooting = false

    -- Set initial randomized timeout (e.g. 3.1s to 4.5s)
    State.CurrentJitter = Config.BaseTimeout + (math.random(1, 15) / 10)

    while c_wait(0.1) do
        local currentTargetCount = ScanTargetOres()
        State.DMCount = currentTargetCount

        if currentTargetCount > 0 then
            State.NoDMTimer = 0
            -- Recalculate random hop threshold for next dry spell
            State.CurrentJitter = Config.BaseTimeout + (math.random(1, 15) / 10)
            StatusLabel.Text = string.format("Mining DM/Rainbow (%d)", currentTargetCount)
            StatusLabel.TextColor3 = Color3.fromRGB(50, 220, 100)
        else
            State.NoDMTimer = State.NoDMTimer + 0.1
            StatusLabel.Text = string.format("No DM %.1fs / %.1fs", State.NoDMTimer, State.CurrentJitter)
            StatusLabel.TextColor3 = Color3.fromRGB(245, 180, 50)

            if State.NoDMTimer >= State.CurrentJitter and Config.HopEnabled and not State.IsHopping then
                HopServer()
            end
        end

        InfoBox.Text = string.format(
            "zone: %s  dm: %d\nhops: %d\nstatus: %s",
            State.InMiningZone and "yes" or "no",
            State.DMCount,
            State.TotalHops,
            State.NoDMTimer > 0 and "hopping soon..." or "active"
        )
    end
end)
