--[[
    DM DIAGNOSTIC - finds out how Dark Matter ore is really represented in the game.
    HOW TO USE:
      1. Go into the Black Hole Core mine and stand right next to a Dark Matter ore block.
      2. Execute this script.
      3. Open the console (F9 / type /console) - or paste the clipboard contents to me.
]]

local Players   = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

local out = {}
local function log(s)
    out[#out + 1] = s
    print("[DM DIAG] " .. s)
end

local function norm(s)
    return (tostring(s):lower():gsub("[^%w]", ""))
end
local function hasDM(s)
    return norm(s):find("darkmatter", 1, true) ~= nil
end

local function attrString(inst)
    local parts = {}
    for k, v in pairs(inst:GetAttributes()) do
        parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
    end
    return table.concat(parts, ", ")
end

local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
log("PlaceId: " .. game.PlaceId .. " | StreamingEnabled: " .. tostring(Workspace.StreamingEnabled))
log(root and ("Player position: " .. tostring(root.Position)) or "No HumanoidRootPart found!")

-- 1) anything anywhere in the workspace that mentions "dark matter"
log("---- SECTION 1: objects mentioning 'dark matter' (name / attribute / value / text) ----")
local hits = 0
for _, inst in ipairs(Workspace:GetDescendants()) do
    if hits >= 150 then log("(capped at 150 results)") break end

    local reason
    if hasDM(inst.Name) then
        reason = "name"
    elseif inst:IsA("StringValue") and hasDM(inst.Value) then
        reason = "StringValue=" .. inst.Value
    elseif (inst:IsA("TextLabel") or inst:IsA("TextButton")) and hasDM(inst.Text) then
        reason = "text=" .. inst.Text
    else
        for k, v in pairs(inst:GetAttributes()) do
            if hasDM(k) or (type(v) == "string" and hasDM(v)) then
                reason = "attribute " .. tostring(k) .. "=" .. tostring(v)
                break
            end
        end
    end

    if reason then
        hits += 1
        log(("%s [%s] via %s"):format(inst:GetFullName(), inst.ClassName, reason))
    end
end
if hits == 0 then
    log("NOTHING in Workspace mentions 'dark matter'. The ore is probably named by an ID/number, or not loaded (streaming), or you're not in the right mine.")
end

-- 2) what is physically around the player
log("---- SECTION 2: nearest parts to the player (within 40 studs) ----")
if root then
    local near = {}
    local char = LocalPlayer.Character
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") and not part:IsDescendantOf(char) then
            local d = (part.Position - root.Position).Magnitude
            if d <= 40 then near[#near + 1] = { part = part, dist = d } end
        end
    end
    table.sort(near, function(a, b) return a.dist < b.dist end)
    for i = 1, math.min(25, #near) do
        local p = near[i].part
        log(("%.1f studs | %s [%s] | color=%s | material=%s | attrs: %s"):format(
            near[i].dist, p:GetFullName(), p.ClassName,
            tostring(p.Color), tostring(p.Material), attrString(p)))
        local parent = p.Parent
        if parent and parent ~= Workspace then
            log("     parent attrs: " .. attrString(parent))
        end
    end
    if #near == 0 then
        log("No parts within 40 studs - map is probably not streamed in, or blocks aren't BaseParts (could be terrain/voxels).")
    end
end

if setclipboard then
    setclipboard(table.concat(out, "\n"))
    print("[DM DIAG] Results copied to clipboard.")
end
