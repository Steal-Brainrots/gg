-- slider
new("TextLabel", {
    Size = UDim2.new(1, -100, 0, 18), Position = UDim2.new(0, 16, 0, 146), BackgroundTransparency = 1,
    Text = "Hop delay (seconds)", TextColor3 = TEXT, Font = Enum.Font.GothamMedium, TextSize = 13,
    TextXAlignment = Enum.TextXAlignment.Left,
}, panel)
local valueLabel = new("TextLabel", {
    Size = UDim2.fromOffset(60, 18), Position = UDim2.new(1, -76, 0, 146), BackgroundTransparency = 1,
    Text = string.format("%.1f", State.hopDelay), TextColor3 = TEXT, Font = Enum.Font.GothamBold, TextSize = 13,
    TextXAlignment = Enum.TextXAlignment.Right,
}, panel)

do
    local MIN, MAX, STEP = 1, 10, 0.5
    local track = new("Frame", {
        Size = UDim2.new(1, -32, 0, 4), Position = UDim2.new(0, 16, 0, 180),
        BackgroundColor3 = Color3.fromRGB(60, 60, 66), BorderSizePixel = 0,
    }, panel)
    corner(track, 2)
    local hit = new("TextButton", { -- bigger click area
        Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0.5, -12), BackgroundTransparency = 1, Text = "",
    }, track)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((State.hopDelay - MIN) / (MAX - MIN), 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
    }, track)
    corner(knob, 7)

    local dragging = false
    local function setFromX(x)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = MIN + alpha * (MAX - MIN)
        v = math.floor(v / STEP + 0.5) * STEP
        State.hopDelay = v
        Save.hopDelay = v
        knob.Position = UDim2.new((v - MIN) / (MAX - MIN), 0, 0.5, 0)
        valueLabel.Text = string.format("%.1f", v)
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            persist()
        end
    end)
end

