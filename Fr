--[[
    Dark Matter Ore ESP + Finder + Server Hop (PS99)
    - Scans the workspace for objects that look like "Dark Matter Ore"
    - Highlights them with ESP (outline + name + distance)
    - If none are found after ScanTime seconds, hops to a new server
    - Stops hopping once an ore is found

    NOTE: Object names are guessed. Use Dex (or similar) to check what the
    ore is actually called in workspace and adjust CONFIG.Keywords if needed.
]]

local CONFIG = {
    -- ALL of these must appear in the object's name (lowercase, letters only)
    Keywords   = { "darkmatter", "ore" },

    -- Ancestors with these names (lowercase) are ignored (pets, GUIs, etc.)
    IgnoreAncestors = { "pets", "inventory", "petsinventory" },

    ScanTime   = 8,      -- seconds to scan a server before hopping
    LoadDelay  = 4,      -- extra wait after joining so the map can stream in
    AutoHop    = true,   -- set false for ESP only
    MinFreeSlots = 1,    -- only join servers with at least this many free slots
    MaxPages   = 5,      -- server list pages to look through

    -- Optional: URL of THIS script (raw link) so it re-runs after teleport.
    -- If empty, put the script in your executor's autoexec folder instead.
    ScriptURL  = "",

    FillColor    = Color3.fromRGB(170, 0, 255),
    OutlineColor = Color3.fromRGB(255, 255, 255),
}

---------------------------------------------------------------------
-- Services
---------------------------------------------------------------------
local Players         = game:GetService("Players")
local RunService      = game:GetService("RunService")
local HttpService     = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local StarterGui      = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
if not game:IsLoaded() then game.Loaded:Wait() end

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
local function notify(title, text, dur)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = dur or 5,
        })
    end)
end

local function normalize(s)
    return (s:lower():gsub("[^%a]", ""))
end

local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok then return res end
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local r = req({ Url = url, Method = "GET" })
        return r and r.Body
    end
    return nil
end

local function nameMatches(inst)
    local n = normalize(inst.Name)
    for _, kw in ipairs(CONFIG.Keywords) do
        if not n:find(kw, 1, true) then return false end
    end
    return true
end

local function isIgnored(inst)
    -- ignore anything belonging to a player character
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and inst:IsDescendantOf(plr.Character) then
            return true
        end
    end
    -- ignore configured ancestor names
    local p = inst.Parent
    while p and p ~= workspace and p ~= game do
        local pn = p.Name:lower()
        for _, bad in ipairs(CONFIG.IgnoreAncestors) do
            if pn == bad then return true end
        end
        p = p.Parent
    end
    return false
end

local function isTarget(inst)
    if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
    if not nameMatches(inst) then return false end
    -- avoid duplicates: skip a part whose parent model already matches
    local parent = inst.Parent
    if parent and parent ~= workspace and parent:IsA("Model") and nameMatches(parent) then
        return false
    end
    return not isIgnored(inst)
end

local function getPosition(inst)
    if inst:IsA("Model") then
        local ok, cf = pcall(function() return inst:GetPivot() end)
        return ok and cf.Position or nil
    end
    return inst.Position
end

---------------------------------------------------------------------
-- ESP
---------------------------------------------------------------------
local tracked = {}      -- [instance] = { highlight, gui, label }
local foundCount = 0

local espFolder = Instance.new("Folder")
espFolder.Name = "DMO_ESP"
pcall(function()
    espFolder.Parent = (gethui and gethui()) or game:GetService("CoreGui")
end)
if not espFolder.Parent then espFolder.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local function removeESP(inst)
    local data = tracked[inst]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.gui then data.gui:Destroy() end
    tracked[inst] = nil
    foundCount = foundCount - 1
end

local function addESP(inst)
    if tracked[inst] then return end

    local hl = Instance.new("Highlight")
    hl.Adornee = inst
    hl.FillColor = CONFIG.FillColor
    hl.OutlineColor = CONFIG.OutlineColor
    hl.FillTransparency = 0.4
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = espFolder

    local gui = Instance.new("BillboardGui")
    gui.Adornee = inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)) or inst
    gui.Size = UDim2.new(0, 200, 0, 40)
    gui.StudsOffset = Vector3.new(0, 4, 0)
    gui.AlwaysOnTop = true
    gui.Parent = espFolder

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0
    label.Text = "Dark Matter Ore"
    label.Parent = gui

    tracked[inst] = { highlight = hl, gui = gui, label = label }
    foundCount = foundCount + 1

    inst.AncestryChanged:Connect(function(_, parent)
        if not parent then removeESP(inst) end
    end)

    notify("Dark Matter Ore", "Found one! Server hopping stopped.", 6)
end

-- Distance label updater
task.spawn(function()
    while task.wait(0.25) do
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            for inst, data in pairs(tracked) do
                local pos = getPosition(inst)
                if pos then
                    local d = (pos - root.Position).Magnitude
                    data.label.Text = string.format("Dark Matter Ore\n[%d studs]", d)
                end
            end
        end
    end
end)

-- Initial scan + live detection of newly streamed-in objects
local function fullScan()
    for _, inst in ipairs(workspace:GetDescendants()) do
        if isTarget(inst) then addESP(inst) end
    end
end

workspace.DescendantAdded:Connect(function(inst)
    -- defer so children/properties exist
    task.defer(function()
        if inst.Parent and isTarget(inst) then addESP(inst) end
    end)
end)

---------------------------------------------------------------------
-- Server hop
---------------------------------------------------------------------
local VISITED_FILE = "dmo_visited.json"
local visited = {}

pcall(function()
    if isfile and isfile(VISITED_FILE) then
        visited = HttpService:JSONDecode(readfile(VISITED_FILE))
    end
end)
visited[game.JobId] = os.time()
-- drop entries older than 30 minutes
for id, t in pairs(visited) do
    if os.time() - t > 1800 then visited[id] = nil end
end
pcall(function()
    if writefile then writefile(VISITED_FILE, HttpService:JSONEncode(visited)) end
end)

local function queueReexecute()
    if CONFIG.ScriptURL ~= "" then
        local q = queue_on_teleport or (syn and syn.queue_on_teleport)
        if q then
            q(('loadstring(game:HttpGet("%s"))()'):format(CONFIG.ScriptURL))
        end
    end
end

local function pickServer()
    local cursor = ""
    for _ = 1, CONFIG.MaxPages do
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s")
            :format(game.PlaceId, cursor ~= "" and ("&cursor=" .. cursor) or "")
        local body = httpGet(url)
        if not body then break end

        local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or not data or not data.data then break end

        local candidates = {}
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId
                and not visited[s.id]
                and s.playing
                and s.maxPlayers
                and (s.maxPlayers - s.playing) >= CONFIG.MinFreeSlots
            then
                table.insert(candidates, s.id)
            end
        end
        if #candidates > 0 then
            return candidates[math.random(1, #candidates)]
        end

        cursor = data.nextPageCursor
        if not cursor then break end
    end
    return nil
end

local hopping = false
local function hop()
    if hopping then return end
    hopping = true

    local id = pickServer()
    if not id then
        notify("Server Hop", "No fresh server found, retrying...", 3)
        hopping = false
        return
    end

    visited[id] = os.time()
    pcall(function()
        if writefile then writefile(VISITED_FILE, HttpService:JSONEncode(visited)) end
    end)

    queueReexecute()
    notify("Server Hop", "No ore here. Hopping...", 3)
    TeleportService:TeleportToPlaceInstance(game.PlaceId, id, LocalPlayer)
end

TeleportService.TeleportInitFailed:Connect(function()
    hopping = false
end)

---------------------------------------------------------------------
-- Main loop
---------------------------------------------------------------------
task.spawn(function()
    -- wait for character + let the map stream in
    LocalPlayer.CharacterAdded:Wait()
    if not LocalPlayer.Character then LocalPlayer.CharacterAdded:Wait() end
    task.wait(CONFIG.LoadDelay)

    local start = os.clock()
    while os.clock() - start < CONFIG.ScanTime do
        fullScan()
        if foundCount > 0 then return end   -- found it, stay here
        task.wait(1)
    end

    if CONFIG.AutoHop and foundCount == 0 then
        while foundCount == 0 do
            hop()
            task.wait(5)
        end
    end
end)
