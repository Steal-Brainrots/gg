local function makeToggle(label, y, default, onChange)
    local row = new("Frame", { Size = UDim2.new(1, -32, 0, 26), Position = UDim2.new(0, 16, 0, y), BackgroundTransparency = 1 }, panel)
    new("TextLabel", {
        Size = UDim2.new(1, -56, 1, 0), BackgroundTransparency = 1, Text = label,
        TextColor3 = TEXT, Font = Enum.Font.GothamMedium, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local pill = new("TextButton", {
        Size = UDim2.fromOffset(44, 22), Position = UDim2.new(1, -44, 0.5, -11),
        Text = "", AutoButtonColor = false, BackgroundColor3 = GRAYOFF,
    }, row)
    corner(pill, 11)
    local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1) }, pill)
    corner(knob, 8)

    local value = default
    local function render()
        local info = TweenInfo.new(0.12)
        TweenService:Create(pill, info, { BackgroundColor3 = value and PURPLE or GRAYOFF }):Play()
        TweenService:Create(knob, info, { Position = value and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) }):Play()
    end
    knob.Position = value and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    pill.BackgroundColor3 = value and PURPLE or GRAYOFF

    pill.MouseButton1Click:Connect(function()
        value = not value
        render()
        onChange(value)
    end)
end

