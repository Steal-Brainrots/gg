-- ---------------------- scanning + ESP ----------------------
local function matches(name)
    name = name:lower()
    for _, kw in ipairs(Config.Keywords) do
        if name:find(kw, 1, true) then return true end
    end
    return false
end

local function baseOf(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end
end

local function scan()
    local root = Workspace:FindFirstChild("__THINGS") or Workspace
    local found = {}
    for _, inst in ipairs(root:GetDescendants()) do
        if (inst:IsA("BasePart") or inst:IsA("Model")) and matches(inst.Name) then
            local parent = inst.Parent
            if not (parent and parent ~= root and matches(parent.Name)) and baseOf(inst) then
                found[#found + 1] = inst
            end
        end
    end
    return found
end

local espObjects = {} -- [target] = { highlight, tag, label }

local function removeESP(target)
    local e = espObjects[target]
    if e then
        e.highlight:Destroy()
        e.tag:Destroy()
        espObjects[target] = nil
    end
end

local function clearESP()
    for target in pairs(espObjects) do removeESP(target) end
end

local function addESP(target)
    local part = baseOf(target)
    if not part then return end
    local highlight = new("Highlight", {
        Adornee = target, FillColor = PURPLE, OutlineColor = Color3.new(1, 1, 1),
        FillTransparency = 0.5, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, gui)
    local tag = new("BillboardGui", {
        Adornee = part, Size = UDim2.fromOffset(140, 30), StudsOffset = Vector3.new(0, 3, 0),
        AlwaysOnTop = true,
    }, gui)
    local label = new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "Dark Matter",
        TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.3,
        Font = Enum.Font.GothamBold, TextSize = 13,
    }, tag)
    espObjects[target] = { highlight = highlight, tag = tag, label = label }
end

local function syncESP(targets)
    local present = {}
    for _, t in ipairs(targets) do present[t] = true end
    for target in pairs(espObjects) do
        if not present[target] or not target.Parent or not State.esp then removeESP(target) end
    end
    if State.esp then
        for _, t in ipairs(targets) do
            if not espObjects[t] then addESP(t) end
        end
    end
end

-- live distance on tags
task.spawn(function()
    while gui.Parent do
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            for target, e in pairs(espObjects) do
                local part = baseOf(target)
                if part then
                    e.label.Text = ("Dark Matter [%d]"):format(math.floor((part.Position - root.Position).Magnitude))
                end
            end
        end
        task.wait(0.25)
    end
end)

-- ---------------------- server hop --------------------------
local hopping = false

local function getServers(cursor)
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end
    local ok, res = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
    return ok and res or nil
end

local function hop()
    if hopping then return end
    hopping = true
    setStatus(YELLOW, "Hopping...", ("Hops: %d"):format(Save.hops))

    local function try()
        local cursor
        for _ = 1, 5 do
            local data = getServers(cursor)
            if data and data.data then
                for _, s in ipairs(data.data) do
                    if not Save.visited[s.id] and s.playing >= Config.MinPlayers
                        and (s.playing / s.maxPlayers) <= Config.MaxFillRatio then
                        Save.visited[s.id] = true
                        Save.hops += 1
                        persist()
                        TeleportService:TeleportToPlaceInstance(PlaceId, s.id, LocalPlayer)
                        return true
                    end
                end
                cursor = data.nextPageCursor
                if not cursor then break end
            else
                task.wait(2) -- rate limited
            end
        end
        return false
    end

    if not try() then
        Save.visited = { [JobId] = true } -- everything visited, start over
        persist()
        task.wait(3)
        try()
    end

    task.wait(10)
    hopping = false -- teleport didn't happen; allow retry
end

TeleportService.TeleportInitFailed:Connect(function()
    hopping = false
    task.wait(2)
    hop()
end)

hopBtn.MouseButton1Click:Connect(function()
    task.spawn(hop)
end)

-- ---------------------- main loop ---------------------------
local startTime = os.clock()
local noOreSince
local teleported = {}

task.spawn(function()
    while gui.Parent do
        if not State.enabled then
            clearESP()
            noOreSince = nil
            setStatus(MUTED, "Disabled", ("Hops: %d"):format(Save.hops))
        else
            local targets = scan()
            syncESP(targets)

            if #targets > 0 then
                noOreSince = nil
                setStatus(GREEN, "Dark Matter found - mine it!",
                    ("%d Dark Matter ore(s) - Hops: %d"):format(#targets, Save.hops))

                if Config.AutoTeleport then
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    for _, t in ipairs(targets) do
                        if root and not teleported[t] then
                            teleported[t] = true
                            local part = baseOf(t)
                            if part then root.CFrame = CFrame.new(part.Position + Vector3.new(0, 4, 0)) end
                            break
                        end
                    end
                end
            else
                local scanning = (os.clock() - startTime) < Config.ScanGrace
                if scanning then
                    setStatus(YELLOW, "Scanning...", ("0 Dark Matter ore(s) - Hops: %d"):format(Save.hops))
                else
                    noOreSince = noOreSince or os.clock()
                    setStatus(RED, "No Dark Matter here", ("0 Dark Matter ore(s) - Hops: %d"):format(Save.hops))
                    if State.autoHop and (os.clock() - noOreSince) >= State.hopDelay then
                        task.spawn(hop)
                    end
                end
            end
        end
        task.wait(1)
    end
end)
